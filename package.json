{
  "name": "stw-vbucks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "auth:setup": "tsx --env-file-if-exists=.env scripts/setup-device-auth.ts",
    "fetch:world": "tsx --env-file-if-exists=.env scripts/fetch-world-info.ts",
    "test": "pnpm -r --if-present test",
    "seed:local": "tsx scripts/seed-local-kv.ts",
    "discord:preview": "tsx --env-file-if-exists=.env scripts/discord-preview.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stw/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
