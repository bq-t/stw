# Cloudflare Pages. The build has out/en/... and out/ru/...; English is served without a prefix.
# Rules run before static files, so assets must pass through explicitly before the catch-all.

# Static assets and root files: serve as is.
/_next/*      /_next/:splat    200
/icons/*      /icons/:splat    200
/images/*     /images/:splat   200
/favicon.ico  /favicon.ico     200
/icon.png     /icon.png        200
/apple-icon.png  /apple-icon.png  200
/sitemap.xml  /sitemap.xml     200
/robots.txt   /robots.txt      200

# Pages moved under /pve (Save the World) and /battle-royale; old links (Discord, search) follow.
# The query string is kept, so /shop?tab=br lands on /pve/shop?tab=br, which sends it on to BR.
/daily-quests        /pve/daily-quests        301
/questline           /pve/questline           301
/side-quests         /pve/side-quests         301
/faq                 /pve/faq                 301
/shop                /pve/shop                301
/events              /pve/events              301
/br/*                /battle-royale/:splat    301
/ru/daily-quests     /ru/pve/daily-quests     301
/ru/questline        /ru/pve/questline        301
/ru/side-quests      /ru/pve/side-quests      301
/ru/faq              /ru/pve/faq              301
/ru/shop             /ru/pve/shop             301
/ru/events           /ru/pve/events           301
/ru/br/*             /ru/battle-royale/:splat 301

# The front page is the tracker for now; a temporary redirect keeps / free for a page of its own.
/                    /pve                     302
/ru                  /ru/pve                  302
/ru/                 /ru/pve                  302

# No duplicate /en URLs for search engines.
/en           /                301
/en/*         /:splat          301

# Russian lives under /ru.
/ru/*         /ru/:splat       200

# Everything else is English.
/*            /en/:splat       200
