{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply stw --remote",
    "db:migrate:local": "wrangler d1 migrations apply stw --local"
  },
  "dependencies": {
    "@stw/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "typescript": "~6.0.3",
    "wrangler": "4.156.2",
    "vitest": "^5.1.0"
  }
}
